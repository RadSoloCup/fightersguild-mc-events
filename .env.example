# fightersguild-mc-events — seasonal battlepass announcements.
#
# The battlepass MECHANICS (XP tracking, rewards, in-game scoreboard/titles)
# run entirely inside the Minecraft server via a KubeJS script
# (kubejs/server_scripts/battlepass.js on the server) — this service does NOT
# talk to the game at all. It only watches the calendar and, once per season,
# posts an announcement to Fluxer and/or creates a Portal event. Season
# names/themes/dates live in src/seasons.js — keep that in sync BY HAND with
# the rotation embedded in battlepass.js if you ever change it.

# Webhook for the target Fluxer channel (channel settings -> Integrations ->
# Webhooks -> New Webhook). Leave unset to skip the Fluxer announcement.
#FLUXER_WEBHOOK_URL=https://chat.example.com/api/webhooks/xxxx/yyyy

# Fighters Guild Portal — posts a matching entry on the Events page (which
# itself cross-posts to Fluxer via the Portal's own bot, if configured there).
# Needs a matching EVENTS_INGEST_TOKEN set on the Portal. Leave unset to skip.
#PORTAL_BASE_URL=https://chat.example.com/portal
#PORTAL_EVENTS_INGEST_TOKEN=

# How often to check whether a new season has started (cron). Cheap to run
# often — it no-ops until the season actually rolls over.
#CRON_CHECK=*/15 * * * *
